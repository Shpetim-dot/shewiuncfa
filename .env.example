# Optional model provider configuration (docs/PROVIDERS.md)
# OpenAI-compatible default endpoint: OpenAI, Mistral, vLLM, LiteLLM, any compatible gateway
CFA_MODEL_BASE_URL=https://api.openai.com/v1
CFA_MODEL_API_KEY=
CFA_MODEL_NAME=gpt-4o-mini
# Native adapters. Model ids select them: anthropic:claude-... / gemini:gemini-2.5-pro
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CFA_MODEL_TIMEOUT=45
CFA_DATABASE_PATH=./data/cfa.db

# Auth: comma-separated token:role:name (roles admin|member|viewer). Unset = open dev mode.
CFA_API_KEYS=
CFA_POSTS_PER_MINUTE=60

# --- v4 settings ---
# Set to production to make the API fail closed (503) when CFA_API_KEYS is empty.
CFA_ENV=
# Encrypts stored MCP server tokens. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CFA_SECRET_KEY=
# Web search for deep research (Brave Search API key). Empty = research only your Brain.
CFA_SEARCH_API_KEY=
# MCP safety: private addresses and plain http are blocked unless you opt in (development only).
CFA_MCP_ALLOW_PRIVATE=
CFA_MCP_ALLOW_INSECURE=
# Pacing of the scripted demo call in seconds (0 = instant).
CFA_DEMO_DELAY=0.9
# Shown in the self-test report footer.
CFA_CONTACT_URL=

# --- v6 settings ---
# Billing: off by default (self-hosted = unlimited). Turn on for a sold deployment.
CFA_BILLING=
# Operator-set plan (pilot or invoiced customers): free | pro | team | pilot. Overrides Stripe.
CFA_PLAN=
# Hugging Face Inference Providers (free monthly credits). Agents use it with model ids like hf:MiniMaxAI/MiniMax-M2
HF_TOKEN=
CFA_MAX_TOKENS=700
# Stripe (test mode first): secret key, webhook signing secret, price ids, public base URL.
# Plans: free, starter, professional, enterprise. docs/BILLING.md has the test walkthrough.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
# Past-due subscriptions keep their plan for this many days before falling back to free.
CFA_GRACE_DAYS=3
# Durable per-organisation rate limiting (docs/OPERATIONS.md). off = development only.
CFA_RATELIMIT=on
CFA_RATELIMIT_DEFAULT=10000
APP_URL=
# Where new leads are posted (a Slack-style incoming webhook, https only) and the security contact on /trust
CFA_LEADS_WEBHOOK=
CFA_SECURITY_CONTACT=
# App logos come from this CDN (empty = monograms only). Or put official SVGs in static/logos/<app-id>.svg
CFA_LOGO_CDN=https://cdn.simpleicons.org
# Backups kept, and a non-/tmp database for production
CFA_BACKUP_KEEP=14

# --- v8: accounts, sessions, organisations ---
# The first organisation is created through POST /api/auth/register (or the setup screen).
# Open this for the very first run only, then set it back to 0. With 0 and at least one user
# existing, only admins can add people (via invitations).
CFA_ALLOW_SIGNUP=1
# Return single-use tokens (verify/reset/invite) in API responses and skip the mailer.
# Development only: anyone who can read the response can take over the account.
CFA_DEV_TOKENS=
# Session lifetime in days and the cookie flags are derived from CFA_ENV (Secure in production).
CFA_SESSION_DAYS=14
# Brute-force protection: attempts per minute per IP/email, and failures before a 15 minute lock.
CFA_AUTH_ATTEMPTS=10
CFA_AUTH_LOCKOUT_AFTER=8
# Require a confirmed email address before login. Needs SMTP below, otherwise nobody can log in.
CFA_REQUIRE_EMAIL_VERIFICATION=0
# Argon2id parameters (defaults are fine; lower them only in tests).
CFA_ARGON2_TIME_COST=2
CFA_ARGON2_MEMORY_COST=65536
CFA_ARGON2_PARALLELISM=2

# Transactional email (invitations, password reset, verification).
# Without SMTP_HOST/SMTP_FROM nothing is sent and the UI says so.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
SMTP_SSL=0
